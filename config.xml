<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://mendes.local/launcher" version="0.1.0" viewmodes="maximized">
    <!-- package = 10 caracteres alfanumericos. MANTER ESTAVEL: se um dia o botao Home
         apontar para este app, o id precisa continuar o mesmo. -->
    <tizen:application id="LMlauncher.Home" package="LMlauncher" required_version="2.4"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>lilauncher</name>
    <description>Launcher pessoal (codigo e interface originais). Privilegios publicos.</description>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/package.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <access origin="*" subdomains="true"/>
    <!-- background-support=enable: o app fica residente ao abrir outro app, então
         voltar (Home) é instantâneo, sem "Loading…"/cold start. (perf em Tizen) -->
    <tizen:setting screen-orientation="landscape" context-menu="disable"
                   background-support="enable" encryption="disable"
                   install-location="auto" hwkey-event="enable"/>
</widget>
